/* Simple Stipple visual system.
 *
 * Written against the semantic names in ``ui/style/tokens.py``: each dollar-
 * prefixed name is substituted at load time. There are no raw colors here, so
 * dark, light, and high-contrast all render from this one file and cannot
 * drift apart.
 *
 * Ordering matters in QSS the way it does in CSS: later rules of equal
 * specificity win. Sections run general -> specific.
 */

/* ══ Shell ═══════════════════════════════════════════════════════════════ */

QMainWindow, QDialog, QMessageBox {
    background: $bg_app;
    color: $text;
}
QWidget#centralwidget {
    background: $bg_app;
}
QScrollArea, QStackedWidget {
    border: none;
    background: transparent;
}

QMenuBar {
    background: $bg_app;
    color: $text_muted;
    border-bottom: 1px solid $border;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 5px 9px;
    border-radius: $radius_sm;
}
QMenuBar::item:selected {
    background: $bg_surface_alt;
    color: $text;
}
QMenu {
    background: $bg_surface;
    color: $text;
    border: 1px solid $border;
    border-radius: $radius_md;
    padding: 5px;
}
QMenu::item {
    padding: 7px 20px;
    border-radius: $radius_sm;
    color: $text;
}
QMenu::item:selected {
    background: $accent_soft;
    color: $accent_text;
}
QMenu::separator {
    height: 1px;
    background: $border;
    margin: 5px 8px;
}

/* ══ Tabs ════════════════════════════════════════════════════════════════
   The workspace switcher. The active tab is marked by an accent underline
   plus full-strength text; inactive tabs are muted so the eye lands on one
   place rather than five equally-weighted words. */

QTabWidget::pane {
    border: none;
    background: transparent;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    color: $text_muted;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 11px 18px 10px;
    margin-right: 4px;
    font-size: $font_sm;
    font-weight: $weight_semibold;
}
QTabBar::tab:hover:!selected {
    color: $text;
    background: $bg_surface_alt;
    border-top-left-radius: $radius_md;
    border-top-right-radius: $radius_md;
}
QTabBar::tab:selected {
    color: $text_strong;
    background: transparent;
    border-bottom-color: $accent;
}
/* The underline already identifies the active tab; a focus rectangle around
   the whole strip on top of it is noise. */
QTabBar:focus {
    border: none;
}

/* ══ Surfaces ════════════════════════════════════════════════════════════ */

QFrame[surface="sidebar"], QFrame[surface="panel"], QFrame[role="hero"],
QFrame[role="page-header"], QFrame[role="status-region"] {
    background: $bg_surface;
    border: 1px solid $border;
    border-radius: $radius_lg;
}
QFrame[surface="canvas"] {
    background: $bg_input;
    border: 1px solid $border;
    border-radius: $radius_lg;
}
QFrame[role="collapsible"], QFrame[role="callout"], QFrame[role="object-browser"],
QFrame[role="status-strip"], QFrame[role="draw-section"], QFrame[role="precision-bar"] {
    background: $bg_surface_alt;
    border: 1px solid $border;
    border-radius: $radius_md;
}
QWidget[role="pattern-side-panel"], QWidget#draw-side-panel {
    background: $bg_surface;
}
QFrame[role="draw-sidebar"] {
    background: $overlay;
    border: 1px solid $border;
    border-radius: $radius_lg;
}
QFrame[role="draw-sidebar"] QScrollBar:vertical {
    width: 8px;
    background: transparent;
    margin: 0;
}
QFrame[role="draw-sidebar"] QScrollBar::handle:vertical {
    background: $border;
    border-radius: $radius_sm;
    min-height: 24px;
}
QFrame[role="draw-sidebar"] QScrollBar::handle:vertical:hover {
    background: $border_strong;
}
QFrame[role="draw-sidebar"] QScrollBar::add-line:vertical,
QFrame[role="draw-sidebar"] QScrollBar::sub-line:vertical {
    height: 0;
}
QFrame[role="drawer-resize-handle"][edge="right"] {
    background: transparent;
    border-right: 2px solid $border;
}
QFrame[role="drawer-resize-handle"][edge="bottom"] {
    background: transparent;
    border-bottom: 2px solid $border;
}
QFrame[role="drawer-resize-handle"]:hover,
QFrame[role="drawer-resize-handle"]:focus {
    border-color: $focus;
}
QFrame[role="hairline"] {
    color: $border;
}
QFrame[role="hsep"] {
    background: $border;
    max-height: 1px;
    border: none;
}
QSplitter::handle {
    background: transparent;
    width: 10px;
}
QSplitter::handle:hover {
    background: $accent_soft;
    border-radius: $radius_sm;
}

/* A failure that blocks the whole application outranks any page, so it is
   loud, persistent, and carries its own actions. */
QFrame[role="system-banner"] {
    background: $danger_soft;
    border: 1px solid $danger_border;
    border-radius: $radius_md;
    color: $danger;
}
QFrame[role="error-toast"] {
    background: $danger_soft;
    border: 1px solid $danger_border;
    border-radius: $radius_sm;
}
QLabel[role="error-toast-title"] {
    color: $danger;
    font-size: $font_md;
    font-weight: $weight_semibold;
}
QLabel[role="error-toast-detail"] {
    color: $text;
    font-size: $font_sm;
}

/* ══ Type ════════════════════════════════════════════════════════════════
   Size and weight carry the hierarchy so color is left free to mean state.
   Three levels only — page, section, body — because a fourth is not
   distinguishable at a glance. */

QLabel[role="page-title"] {
    color: $text_strong;
    font-size: $font_2xl;
    font-weight: $weight_bold;
}
QLabel[role="shell-title"], QLabel[role="title"], QLabel#title {
    color: $text_strong;
    font-size: $font_lg;
    font-weight: $weight_bold;
}
QLabel[role="dialog-title"] {
    color: $text_strong;
    font-size: $font_xl;
    font-weight: $weight_bold;
}
QLabel[role="section-title"], QLabel[role="callout-title"],
QLabel[role="collapsible-toggle-static"] {
    color: $text;
    font-size: $font_md;
    font-weight: $weight_semibold;
}
QLabel[role="section-label"], QLabel[role="eyebrow"], QLabel[role="shell-eyebrow"],
QLabel[role="input-header"] {
    color: $text_subtle;
    font-size: $font_2xs;
    font-weight: $weight_bold;
    letter-spacing: 1.1px;
    padding: 8px 0 4px 0;
}
QLabel[role="page-subtitle"], QLabel[role="shell-subtitle"], QLabel[role="dialog-subtitle"],
QLabel[role="dialog-message"], QLabel[role="callout-body"], QLabel[role="hint"],
QLabel[role="hint-sm"], QLabel[role="field-label"], QLabel[role="dim"],
QLabel[role="section-subtitle"] {
    color: $text_muted;
    background: transparent;
    font-size: $font_xs;
}
QLabel[role="text-preview"] {
    background: $bg_input;
    border: 1px solid $border;
    border-radius: $radius_sm;
    color: $text;
    font-size: $font_xl;
}
QLabel[role="section-subtitle"] {
    padding-left: 18px;
}
QLabel[role="section-subtitle"][dim="true"] {
    color: $text_subtle;
}
QLabel[role="shell-sep"], QLabel[role="toolbar-sep"] {
    color: $border_strong;
    font-size: $font_md;
}
QLabel[role="shell-meta"] {
    color: $text;
    font-size: $font_sm;
    font-weight: $weight_medium;
}

/* ══ Buttons ═════════════════════════════════════════════════════════════
   Von Restorff: exactly one filled accent button per surface. Everything
   else is an outline or a bare label, so the filled one is unmissable and
   "what do I do next" never needs a second look. */

QPushButton, QToolButton {
    min-height: 30px;
    min-width: 24px;
    padding: 5px 12px;
    border: 1px solid $border;
    border-radius: $radius_md;
    background: $bg_surface;
    color: $text;
    font-size: $font_sm;
    font-weight: $weight_medium;
}
QPushButton:hover, QToolButton:hover {
    background: $bg_surface_alt;
    border-color: $border_strong;
}
QPushButton:pressed, QToolButton:pressed {
    background: $bg_input;
}
QPushButton:disabled, QToolButton:disabled {
    background: $bg_surface_alt;
    border-color: $border;
    color: $text_subtle;
}

QPushButton[role="primary"] {
    background: $accent;
    border: 1px solid $accent;
    color: $on_accent;
    min-height: 34px;
    padding: 6px 18px;
    font-weight: $weight_bold;
}
QPushButton[role="primary"]:hover {
    background: $accent_hover;
    border-color: $accent_hover;
}
QPushButton[role="primary"]:pressed {
    background: $accent_pressed;
    border-color: $accent_pressed;
}
QPushButton[role="primary"]:disabled {
    background: $bg_surface_alt;
    border-color: $border;
    color: $text_subtle;
    font-weight: $weight_medium;
}

QPushButton[role="secondary"], QPushButton[role="ghost"], QToolButton {
    background: transparent;
    color: $text_muted;
}
QPushButton[role="ghost"] {
    border-color: transparent;
}
QPushButton[role="secondary"]:hover, QPushButton[role="ghost"]:hover,
QToolButton:hover {
    color: $text;
    background: $bg_surface_alt;
}
QPushButton[role="danger"] {
    background: $danger_soft;
    border-color: $danger_border;
    color: $danger;
}
QPushButton[role="danger"]:hover {
    background: $danger_soft;
    border-color: $danger;
}

/* Selected / active state is one language everywhere: soft accent fill,
   accent border, accent text. */
QPushButton[active="true"], QPushButton:checked, QToolButton[active="true"],
QToolButton:checked, QPushButton[role="cycle-icon"]:checked {
    background: $accent_soft;
    border-color: $accent_border;
    color: $accent_text;
}
QPushButton[role="tool-item"] {
    text-align: left;
    padding-left: 14px;
}
QPushButton[role="tool-item"][active="true"] {
    background: $accent_soft;
    border-left: 3px solid $accent;
    border-color: $accent_border;
    color: $accent_text;
}
QPushButton[role="mode-button"] {
    min-width: 64px;
    background: transparent;
    border-color: transparent;
    color: $text_muted;
    font-weight: $weight_medium;
}
QPushButton[role="mode-button"][active="true"] {
    background: $accent_soft;
    border-color: $accent_border;
    color: $accent_text;
}
/* Square glyph buttons (the − / + steppers): the default horizontal padding
   leaves no room for the glyph and clips it to nothing. */
QPushButton[role="icon-sm"] {
    padding: 0px;
    font-size: $font_md;
}
QPushButton[role="browse-btn"] {
    padding: 4px 8px;
    font-size: $font_xs;
}
QPushButton[role="cycle-icon"] {
    background: $bg_input;
    border: 1px solid $border;
    min-height: 40px;
}
QPushButton[role="cycle-icon"]:hover {
    border-color: $accent_border;
}
QToolButton[role="drawer-toggle"] {
    background: $overlay;
    border: 1px solid $accent;
    color: $accent_text;
    font-weight: $weight_semibold;
}
QToolButton[role="drawer-toggle"]:hover {
    background: $accent_soft;
}
/* "⋯" already reads as "more"; the default menu arrow on top of it is noise. */
QToolButton[role="overflow"]::menu-indicator {
    image: none;
    width: 0px;
}
QToolButton[role="collapsible-toggle"] {
    text-align: left;
    padding: 4px;
    color: $text;
    font-size: $font_sm;
    font-weight: $weight_semibold;
    letter-spacing: 0.2px;
    border: none;
    background: transparent;
}
QToolButton[role="collapsible-toggle"]:hover {
    background: $accent_soft;
    color: $accent_text;
}

/* ══ Focus ═══════════════════════════════════════════════════════════════
   One unmistakable focus treatment on everything reachable by keyboard.
   Item views and tabs suppress their platform outline, so without this they
   would show no focus at all. */

QPushButton:focus, QToolButton:focus, QLineEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QCheckBox:focus, QRadioButton:focus,
QSlider:focus, QListWidget:focus, QTreeView:focus, QTreeWidget:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 2px solid $focus;
    border-radius: $radius_md;
}

/* ══ Inputs ══════════════════════════════════════════════════════════════ */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit,
QListWidget {
    background: $bg_input;
    color: $text;
    border: 1px solid $border;
    border-radius: $radius_md;
    padding: 5px 9px;
    selection-background-color: $selection;
    selection-color: $text_strong;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: $border_strong;
}
QLineEdit:read-only {
    background: $bg_surface_alt;
    color: $text_muted;
}
/* Validation failure is shown on the field itself, next to the value that
   caused it, rather than in a modal that hides the form behind it. */
QLineEdit[error="true"], QComboBox[error="true"], QSpinBox[error="true"],
QDoubleSpinBox[error="true"] {
    border: 1px solid $danger;
    background: $danger_soft;
}
QLineEdit[role="canvas-hud-input"], QSpinBox[role="canvas-hud-input"] {
    background: $bg_input;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    font-size: $font_sm;
    font-family: $mono;
    padding: 3px 7px;
}
QLabel[role="canvas-hud-label"] {
    background: $bg_surface;
    color: $text_muted;
    border: none;
    font-size: $font_2xs;
    font-weight: $weight_medium;
    padding: 0 2px;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url({ICONS_DIR}/chevron_down.svg);
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background: $bg_surface;
    color: $text;
    border: 1px solid $border;
    border-radius: $radius_md;
    padding: 5px;
    selection-background-color: $accent_soft;
    outline: none;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}
QPlainTextEdit[role="log"], QTextEdit {
    font-family: $mono;
    font-size: $font_xs;
}
QTextEdit[role="release-notes"] {
    color: $text_muted;
}

QCheckBox, QRadioButton {
    color: $text;
    spacing: 9px;
    min-height: 32px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid $border_strong;
    background: $bg_input;
}
QCheckBox::indicator {
    border-radius: 5px;
}
QRadioButton::indicator {
    border-radius: 9px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $accent_border;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: $accent;
    border-color: $accent;
}

QSlider {
    min-height: 32px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: $border;
    border-radius: 2px;
    margin: 0 4px;
}
QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: $bg_surface;
    border: 3px solid $accent;
    width: 13px;
    height: 13px;
    margin: -6px -1px;
    border-radius: 10px;
}
QSlider::handle:horizontal:hover {
    border-color: $accent_hover;
}

QProgressBar {
    background: $bg_input;
    color: $text_muted;
    border: 1px solid $border;
    border-radius: 5px;
    min-height: 10px;
    text-align: center;
}
QProgressBar::chunk {
    background: $accent;
    border-radius: 4px;
}

QGroupBox {
    border: 1px solid $border;
    border-radius: $radius_md;
    color: $text;
    font-weight: $weight_semibold;
    margin-top: 12px;
    padding: 12px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: $text_muted;
}

/* ══ Progress and orientation ════════════════════════════════════════════
   The workflow strip answers "where am I, and what is next" before the user
   has to hunt for it — the steps are a narrative, not decoration. */

QFrame[role="workflow-strip"] {
    background: $bg_surface;
    border-bottom: 1px solid $border;
}
QLabel[role="workflow-title"] {
    color: $text_strong;
    font-size: $font_md;
    font-weight: $weight_bold;
}
QLabel[role="workflow-description"] {
    color: $text_muted;
    font-size: $font_xs;
}
/* The single most important sentence on the page: the next action. */
QLabel[role="workflow-guidance"] {
    background: $accent_soft;
    border: 1px solid $accent_border;
    border-radius: $radius_md;
    color: $accent_text;
    padding: 5px 10px;
    font-size: $font_xs;
    font-weight: $weight_semibold;
}
QLabel[role="workflow-guidance"][tone="success"] {
    background: $success_soft;
    border-color: $success_border;
    color: $success;
}
QLabel[role="workflow-guidance"][tone="warn"] {
    background: $warn_soft;
    border-color: $warn_border;
    color: $warn;
}
QLabel[role="workflow-guidance"][tone="danger"] {
    background: $danger_soft;
    border-color: $danger_border;
    color: $danger;
}
QToolButton[role="workflow-step"] {
    border: none;
    background: transparent;
    padding: 4px 10px;
    min-height: 32px;
    font-size: $font_sm;
    font-weight: $weight_medium;
    color: $text_subtle;
}
QToolButton[role="workflow-step"][state="current"] {
    background: $accent_soft;
    color: $accent_text;
    border-radius: $radius_md;
    font-weight: $weight_bold;
}
QToolButton[role="workflow-step"][state="complete"] {
    color: $success;
}
QToolButton[role="workflow-step"][state="stale"] {
    color: $warn;
    background: $warn_soft;
    border-radius: $radius_md;
}
QToolButton[role="workflow-step"][state="error"] {
    color: $danger;
    background: $danger_soft;
    border-radius: $radius_md;
}
QLabel[role="workflow-arrow"] {
    color: $text_subtle;
}
QToolButton[role="context-action"] {
    background: $bg_surface_alt;
    border: 1px solid $border;
    border-radius: $radius_sm;
    color: $text;
    font-size: $font_xs;
    font-weight: $weight_semibold;
    padding: 3px 8px;
}
QToolButton[role="context-action"]:hover,
QToolButton[role="context-action"]:focus {
    background: $accent_soft;
    border-color: $accent_border;
    color: $accent_text;
}

/* ══ Status ══════════════════════════════════════════════════════════════
   One vocabulary for outcome: neutral, ok, warn, error. Same colors, same
   shapes, whether it appears as a chip, a banner, or a region. */

QFrame[role="status-region"][tone="success"] {
    border-color: $success_border;
}
QFrame[role="status-region"][tone="warn"] {
    border-color: $warn_border;
}
QFrame[role="status-region"][tone="danger"] {
    border-color: $danger_border;
    background: $danger_soft;
}
QFrame[role="operation-progress"] {
    background: $bg_surface_alt;
    border: 1px solid $border;
    border-radius: $radius_md;
}
QFrame[role="operation-progress"][tone="danger"] {
    background: $danger_soft;
    border-color: $danger_border;
}
QLabel[role="operation-progress-label"] {
    color: $text_muted;
    font-size: $font_sm;
}
QFrame[role="operation-progress"][tone="danger"] QLabel[role="operation-progress-label"] {
    color: $danger;
}

QLabel[role="chip"], QLabel[role="summary-banner"], QLabel[role="status-chip"] {
    background: $bg_surface_alt;
    border: 1px solid $border;
    border-radius: $radius_md;
    color: $text_muted;
    padding: 4px 9px;
    font-size: $font_xs;
    font-weight: $weight_medium;
}
QLabel[role="chip"][tone="accent"], QLabel[role="summary-banner"][tone="accent"] {
    background: $accent_soft;
    border-color: $accent_border;
    color: $accent_text;
}
QLabel[role="chip"][tone="success"], QLabel[role="summary-banner"][tone="success"] {
    background: $success_soft;
    border-color: $success_border;
    color: $success;
}
QLabel[role="chip"][tone="warn"], QLabel[role="summary-banner"][tone="warn"] {
    background: $warn_soft;
    border-color: $warn_border;
    color: $warn;
}
QLabel[role="chip"][tone="danger"], QLabel[role="summary-banner"][tone="danger"] {
    background: $danger_soft;
    border-color: $danger_border;
    color: $danger;
}

QLabel[role="status-ok"] {
    color: $success;
    background: $success_soft;
    border: 1px solid $success_border;
    border-radius: $radius_sm;
    padding: 4px 8px;
    font-size: $font_xs;
}
QLabel[role="status-err"] {
    color: $danger;
    background: $danger_soft;
    border: 1px solid $danger_border;
    border-radius: $radius_sm;
    padding: 4px 8px;
    font-size: $font_xs;
}
QLabel[role="status-warn"] {
    color: $warn;
    background: $warn_soft;
    border: 1px solid $warn_border;
    border-radius: $radius_sm;
    padding: 4px 8px;
    font-size: $font_xs;
}
QLabel[role="status-neutral"] {
    color: $text_muted;
    background: transparent;
    border: 1px solid transparent;
    border-radius: $radius_sm;
    padding: 4px 8px;
    font-size: $font_xs;
}
QLabel[role="preview-ok"] {
    color: $success;
    background: transparent;
    font-size: $font_xs;
}
QLabel[role="preview-err"] {
    color: $danger;
    background: transparent;
    font-size: $font_xs;
}
QLabel[role="preview-dim"] {
    color: $text_muted;
    background: transparent;
    font-size: $font_xs;
}

/* ══ Lists, trees, tables ════════════════════════════════════════════════ */

QListWidget::item, QTreeWidget::item, QTreeView::item {
    padding: 6px 8px;
    margin: 1px 0;
    border-radius: $radius_sm;
    color: $text;
}
QListWidget::item:hover:!selected, QTreeWidget::item:hover:!selected,
QTreeView::item:hover:!selected {
    background: $bg_surface_alt;
}
QListWidget::item:selected, QTreeWidget::item:selected, QTreeView::item:selected {
    background: $accent_soft;
    color: $accent_text;
    border: 1px solid $accent_border;
}
QTreeWidget {
    background: transparent;
    border: none;
    outline: none;
    alternate-background-color: $scrim;
}
QTreeWidget::branch {
    background: transparent;
}
/* The row-visibility box is an item-view indicator, not a QCheckBox, so it
   needs its own rule — otherwise Fusion fills the cell with an opaque
   highlight square that reads as a stray color swatch. */
QTreeView::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    background: $bg_input;
}
QTreeView::indicator:checked {
    background: $accent;
    border-color: $accent;
    image: url({ICONS_DIR}/check.svg);
}
QTreeView::indicator:unchecked:hover {
    border-color: $accent_border;
}
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url({ICONS_DIR}/chevron_right.svg);
}
QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url({ICONS_DIR}/chevron_down.svg);
}
/* The inline rename editor inherits the generic QLineEdit padding, which is
   taller than a tree row and clips the text it is meant to show. */
QTreeWidget QLineEdit {
    padding: 0px 4px;
    margin: 0px;
    border: 1px solid $accent;
    border-radius: 3px;
    background: $bg_input;
    color: $text;
}
QHeaderView::section {
    background: $bg_surface_alt;
    color: $text_muted;
    border: none;
    border-bottom: 1px solid $border;
    padding: 7px;
    font-weight: $weight_semibold;
}
QTableView, QTableWidget {
    background: $bg_input;
    alternate-background-color: $bg_surface_alt;
    border: 1px solid $border;
    border-radius: $radius_md;
    gridline-color: $border;
}
QTableView::item:selected, QTableWidget::item:selected {
    background: $selection;
    color: $text_strong;
}

/* ══ Scrollbars, tooltips ════════════════════════════════════════════════ */

QScrollBar:vertical {
    width: 6px;
    background: transparent;
    margin: 0;
}
QScrollBar:horizontal {
    height: 6px;
    background: transparent;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: $border_strong;
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: $text_muted;
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    border: none;
    height: 0;
    width: 0;
}

QToolTip {
    background: $bg_surface;
    color: $text;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    padding: 6px 9px;
}

/* ══ Canvas chrome ═══════════════════════════════════════════════════════
   The drawing surface itself stays dark in every appearance so geometry
   reads identically; the chrome floating over it follows the theme. */

QWidget#canvas-toolbar {
    background: $overlay;
    border: 1px solid $border;
    border-radius: $radius_md;
}
QLabel[role="toolbar-label"] {
    color: $text_subtle;
    font-size: $font_2xs;
    font-weight: $weight_bold;
}
QLabel[role="toolbar-guidance"] {
    color: $text_muted;
    font-size: $font_xs;
    padding-left: 8px;
}
QLabel[role="toolbar-selection"], QLabel[role="status-meta"],
QLabel[role="status-selection"], QLabel[role="status-zoom"] {
    color: $text_muted;
    font-size: $font_xs;
}
QLabel[role="status-mode"], QLabel[role="status-selection"][active="true"],
QLabel[role="toolbar-selection"][active="true"] {
    color: $accent_text;
    font-size: $font_xs;
    font-weight: $weight_medium;
}
QLabel[role="status-detail"] {
    color: $text_subtle;
    font-size: $font_2xs;
}
QLabel[role="status-coordinates"] {
    color: $text_subtle;
    font-size: $font_2xs;
    font-family: $mono;
}
QLabel[role="status-separator"] {
    color: $border;
    font-size: $font_xs;
}
QLabel[role="zone-edit-scope"] {
    color: $text_muted;
    border: 1px solid $border;
    border-radius: $radius_sm;
    padding: 8px;
}
QLabel[role="zone-edit-scope"][editing="true"] {
    color: $accent_text;
    background: $accent_soft;
    border-color: $accent_border;
    font-weight: $weight_semibold;
}

/* ══ Empty states ════════════════════════════════════════════════════════
   The first screen a user meets on a page. It names the surface, says what
   to do, and stays out of the way once there is real content. These sit on
   the invariant ink backdrop, so their text is fixed light rather than
   theme-following. */

QWidget[role="empty-state"], QFrame[role="preview-surface"],
QFrame#conversion-preview, QFrame#conversion-preview QStackedWidget,
QFrame#conversion-preview QWidget[role="empty-state"] {
    background: $bg_ink;
}
QWidget[role="empty-state"] QLabel[role="empty-icon"],
QFrame[role="preview-surface"] QLabel[role="empty-icon"] {
    color: $ink_muted;
    font-size: $font_display;
}
QWidget[role="empty-state"] QLabel[role="empty-title"],
QFrame[role="preview-surface"] QLabel[role="empty-title"] {
    color: $ink_text;
    font-size: $font_lg;
    font-weight: $weight_semibold;
}
QWidget[role="empty-state"] QLabel[role="empty-hint"],
QFrame[role="preview-surface"] QLabel[role="empty-hint"] {
    color: $ink_muted;
    font-size: $font_sm;
}

/* ══ Named dialogs ═══════════════════════════════════════════════════════ */

QDialog#command-palette, QDialog#keybindings-dialog, QDialog#radial-menu-dialog,
QDialog#draw-sidebar-customize-dialog {
    background: $bg_app;
}
QDialog#command-palette QLineEdit, QDialog#keybindings-dialog QLineEdit {
    background: $bg_input;
    font-size: $font_lg;
    padding: 10px 12px;
}
QWidget#helpHeader {
    background: $bg_surface;
    border-bottom: 1px solid $border;
}
QLabel#helpTitle {
    color: $text_strong;
    font-size: $font_xl;
    font-weight: $weight_bold;
}
QWidget#tocPanel {
    background: $bg_surface;
    border-right: 1px solid $border;
}
QLabel#tocLabel {
    color: $text_subtle;
    font-size: $font_2xs;
    font-weight: $weight_bold;
    letter-spacing: 1.1px;
    padding: 4px 16px;
}
QLabel#tocSearchStatus {
    color: $text_muted;
    font-size: $font_2xs;
    padding: 0 16px 4px 16px;
}
QPushButton#helpCloseButton {
    background: transparent;
    color: $text_muted;
    border: none;
    font-size: $font_lg;
}
QPushButton#helpCloseButton:hover {
    color: $text;
    background: $bg_surface_alt;
}
QPushButton#helpBrowseButton {
    min-height: 28px;
    padding: 4px 10px;
}
QLineEdit#tocSearch {
    margin: 0 8px 4px 8px;
}
QListWidget#tocList {
    background: transparent;
    border: none;
    padding: 4px;
}
QListWidget#tocList::item {
    min-height: 24px;
    padding: 3px 8px;
    border-radius: $radius_sm;
}
QTextBrowser#helpContent {
    background: $bg_ink;
    color: $ink_text;
    border: none;
    border-radius: $radius_sm;
    line-height: 1.7;
}
