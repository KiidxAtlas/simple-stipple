;correct GLOCK TEMPLATES__G22.svg
COUNTEX = DEFAULT_DEFAULT.COUNT()
FOR _TEMPINT = 1 TO COUNTEX
   DEFAULT_DEFAULT.Passes = 1
   FOR PASSEX = 1 TO DEFAULT_DEFAULT.PARAMETERS(_TEMPINT,0)
      IF _TEMPINT = 1 AND COUNTEX = 1
         LASERPOWER 50.000
         DRAWSPEED 1500.000
         LASERFREQ 50.000
      ENDIF
      FILLTYPE 0
      MOVEABS 383.164,-882.963
      ROTATEABS 0.000
      TEXTSCALEX 100.000
      IMAGEJUSTIFY 0
      IMAGEHEIGHT 423.2922
      DRAWFVI "C:\\Users\\Application Lab\\Desktop\\Gun Template Rework\\GLOCK\\G22 Right\\1.Fvi"
      TEXTSCALEX 100
      TEXTSCALEY 100
   NEXT
NEXT
RETURN


CLASS DEFAULT_DEFAULT

PRIVATE Fill as INTEGER
PRIVATE Passes as INTEGER

FUNCTION Count()
   RETURN 1
ENDFUNCTION

FUNCTION Parameters(i AS INTEGER, J AS INTEGER)
   FILL = J
   SELECT i
   CASE 1
      LASERPOWER 50.000 * LaserPowerOverrideEX
      LASERFREQ 50.000 * LaserFreqOverrideEX
      DRAWSPEED 1500.000 * LaserSpeedOverrideEX
      MOVESPEED 3500.000
      LASERDUTY 110.000
      TC 0,75
      TC 1,150
      TC 2,250
      TC 3,300
      TC 4,10
      TC 5,10
      TC 6,0
      TC 7,0
      DRAWWIDTH 0.000,0.000
      IF J == 0
         FILLTYPE 0
      ELSE
         POINT 0, 0
         OBJECTFILL 0
         DEFFILL 1,"2,90.000,0.030,0.000,0"
         USEFILL 1
         FILLTYPE 1
      ENDIF
      RETURN PASSES
   ENDSELECT
ENDFUNCTION

ENDCLASS


